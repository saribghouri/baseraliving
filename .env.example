# Leave these blank to run the site from the local files in lib/.
# Fill them in to switch the site over to the Sanity Studio at /studio.
#
#   1. Create a free project at https://sanity.io/manage
#   2. Copy the Project ID it gives you
#   3. Add http://localhost:3000 and your live domain under API → CORS origins
#
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
